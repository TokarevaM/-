
#Область СведенияОбОбработке

Функция СведенияОВнешнейОбработке()Экспорт
	
	ПараметрыРегистрации = Новый Структура;
	МассивНазначений = Новый Массив;
	МассивНазначений.Добавить("Документ.КоммерческоеПредложение"); //Указываем документ к которому делаем внешнюю печ. форму
	ПараметрыРегистрации.Вставить("Вид", "ПечатнаяФорма"); //может быть - ПечатнаяФорма, ЗаполнениеОбъекта, ДополнительныйОтчет, СозданиеСвязанныхОбъектов... 
	ПараметрыРегистрации.Вставить("Назначение", МассивНазначений);
	ПараметрыРегистрации.Вставить("Наименование", "Заявка"); //имя под которым обработка будет зарегестрирована в справочнике внешних обработок
	ПараметрыРегистрации.Вставить("БезопасныйРежим", ЛОЖЬ);
	ПараметрыРегистрации.Вставить("Версия", "1.0"); 
	ПараметрыРегистрации.Вставить("Информация", "Заявка"); 
	ТаблицаКоманд = ПолучитьТаблицуКоманд();
	ДобавитьКоманду(ТаблицаКоманд, "Заявка", "Макет", "ВызовСерверногоМетода", Истина, "ПечатьMXL");
	ПараметрыРегистрации.Вставить("Команды", ТаблицаКоманд);
	
	Возврат ПараметрыРегистрации;
	
КонецФункции


Функция ПолучитьТаблицуКоманд()
	
	Команды = Новый ТаблицаЗначений;
	Команды.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка")); 
	Команды.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	Команды.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));
	
	Возврат Команды;
	
КонецФункции

Процедура ДобавитьКоманду(ТаблицаКоманд, Представление, Идентификатор, Использование, ПоказыватьОповещение = Ложь, Модификатор = "")
	
	НоваяКоманда = ТаблицаКоманд.Добавить();
	НоваяКоманда.Представление = Представление;
	НоваяКоманда.Идентификатор = Идентификатор;
	НоваяКоманда.Использование = Использование;
	НоваяКоманда.ПоказыватьОповещение = ПоказыватьОповещение;
	НоваяКоманда.Модификатор = Модификатор;
	
КонецПроцедуры

#КонецОбласти

Процедура Печать(МассивОбъектов, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "Макет", "Заявка", СформироватьПечатнуюФорму(МассивОбъектов[0]));
	
КонецПроцедуры

//весь код здесь
&НаСервере
Функция СформироватьПечатнуюФорму(КоммерческоеПредложение) Экспорт
	
    Результат = Новый ТабличныйДокумент; 
	
	Результат.ОтображатьСетку = Ложь;
	Результат.ОтображатьЗаголовки = Ложь;
	Результат.АвтоМасштаб = Истина;
    Результат.Защита = Истина;  
	
	Макет = ПолучитьМакет("Макет");
	
	//ОбластьДанныеОрганизацииСЛоготипом = Макет.ПолучитьОбласть("ДанныеОрганизацииСЛоготипом");
	ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок");    
	//ОбластьПокупатель = Макет.ПолучитьОбласть("Покупатель"); 
	ОбластьТема = Макет.ПолучитьОбласть("Тема");	
	ОбластьШапкаТаблицы = Макет.ПолучитьОбласть("ШапкаТаблицы"); 
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка"); 
   	ОбластьИтогоПоДокументу = Макет.ПолучитьОбласть("ИтогоПоДокументу"); 
	ОбластьСуммаПрописью = Макет.ПолучитьОбласть("СуммаПрописью");	
    ОбластьСрокДействия = Макет.ПолучитьОбласть("СрокДействия");
	ОбластьЗаказчик = Макет.ПолучитьОбласть("Заказчик");	
	ОбластьПолученоИсполнителем = Макет.ПолучитьОбласть("ПолученоИсполнителем");	
	
	//ОбластьДанныеОрганизацииСЛоготипом.Параметры.ПредставлениеОрганизация = КоммерческоеПредложение.Организация.Наименование;
	//Результат.Вывести(ОбластьДанныеОрганизацииСЛоготипом);
		
	ОбластьЗаголовок.Параметры.Номер = КоммерческоеПредложение.Номер;  
	
	//убираем лидирующие нули (было 0000-000013)
	Если ТипЗнч(КоммерческоеПредложение.Номер) = Тип("Строка") Тогда
		ОбластьЗаголовок.Параметры.Номер = ПолучитьТолькоЧисловуюЧасть(КоммерческоеПредложение.Номер);
	Иначе
		ОбластьЗаголовок.Параметры.Номер = Строка(КоммерческоеПредложение.Номер);
	КонецЕсли;

	//дата без времени	   
	ОбластьЗаголовок.Параметры.Дата = Формат(КоммерческоеПредложение.Дата, "ДЛФ=DD");
	Результат.Вывести(ОбластьЗаголовок);
	
	ОбластьТема.Параметры.Тема = КоммерческоеПредложение.Тема;	
	Результат.Вывести(ОбластьТема);
	
	Результат.Вывести(ОбластьШапкаТаблицы);	
	
	СуммаВсего = 0;
	КоличествоВсего = 0;
	Для каждого СтрокаТЧ Из КоммерческоеПредложение.Товары Цикл   
		ОбластьСтрока.Параметры.НомерСтроки = СтрокаТЧ.НомерСтроки;
		ОбластьСтрока.Параметры.Товар = СтрокаТЧ.Содержание;
		ОбластьСтрока.Параметры.Количество = СтрокаТЧ.Количество; 
		ОбластьСтрока.Параметры.Цена = СтрокаТЧ.Цена;  
		ОбластьСтрока.Параметры.Сумма = СтрокаТЧ.Сумма;  
		ОбластьСтрока.Параметры.ДатаВыполнения = СтрокаТЧ.ДатаВыполнения;  
		Результат.Вывести(ОбластьСтрока);
		
		// Накопление суммы и кол-ва
		СуммаВсего = СуммаВсего + СтрокаТЧ.Сумма;  
		КоличествоВсего = КоличествоВсего + СтрокаТЧ.Количество; 
	КонецЦикла; 

    // Выводим итоговую сумму и кол-во
	ОбластьИтогоПоДокументу.Параметры.ИтогоПоДокументу = СуммаВсего; 
	ОбластьИтогоПоДокументу.Параметры.КоличествоВсего = КоличествоВсего; 
	Результат.Вывести(ОбластьИтогоПоДокументу);
	
    ОбластьСуммаПрописью.Параметры.СуммаПрописью = ЧислоПрописью(СуммаВсего,  , "рубль,рубля,рублей,м,копейка,копейки,копеек,ж,2");	
    Результат.Вывести(ОбластьСуммаПрописью);		
	
	ОбластьСрокДействия.Параметры.СрокДействия = Формат(КоммерческоеПредложение.СрокДействия, "ДЛФ=DD");
	Результат.Вывести(ОбластьСрокДействия);	
	
	ОбластьЗаказчик.Параметры.ФИОРуководителя = КоммерческоеПредложение.КонтактноеЛицо;    
	ОбластьЗаказчик.Параметры.Контрагент = КоммерческоеПредложение.Контрагент; 
	Результат.Вывести(ОбластьЗаказчик);                          
	
	ОбластьПолученоИсполнителем.Параметры.ФИОИсполнителя = КоммерческоеПредложение.Руководитель; 
	Результат.Вывести(ОбластьПолученоИсполнителем);                          
	
	
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьСтруктуруПараметровШаблона(СсылкаНаОбъект, СтруктураПШ, ДатаДанных = Неопределено)
	
	СтруктураПШ.Вставить("ШаблонПараметра", "Шаблон текста");	
	
КонецПроцедуры

//для номера убираем лидирующие нули
Функция ПолучитьТолькоЧисловуюЧасть(Номер)
	
	Если ПустаяСтрока(Номер) Тогда
		Возврат "";
	КонецЕсли;

	Части = СтрРазделить(Номер, "-");
	
	// Если дефиса нет — пробуем просто убрать лидирующие нули
	Если Части.Количество() < 2 Тогда
		Индекс = 1;
		Пока Индекс <= СтрДлина(Номер) И Сред(Номер, Индекс, 1) = "0" Цикл
			Индекс = Индекс + 1;
		КонецЦикла;
		Результат = Сред(Номер, Индекс);
		Возврат ?(ПустаяСтрока(Результат), "0", Результат);
	КонецЕсли;

	ЧисловаяЧасть = Части[1];

	// Убираем лидирующие нули в числовой части
	Индекс = 1;
	Пока Индекс <= СтрДлина(ЧисловаяЧасть) И Сред(ЧисловаяЧасть, Индекс, 1) = "0" Цикл
		Индекс = Индекс + 1;
	КонецЦикла;

	Результат = Сред(ЧисловаяЧасть, Индекс);

	// Если были одни нули — возвращаем "0", а не пустую строку
	Возврат ?(ПустаяСтрока(Результат), "0", Результат); 
	
КонецФункции



