
Функция СформироватьТаблицуДублейПоИНН(СсылкаНаОбработку = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Контрагенты.Ссылка КАК Контрагент,
		|	Контрагенты.Наименование КАК Наименование,
		|	Контрагенты.ИНН КАК ИНН,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(Контрагенты.Фамилия, """") <> """"
		|			ТОГДА ЕСТЬNULL(Контрагенты.Фамилия, """") + "" "" + ЕСТЬNULL(Контрагенты.Имя, """")
		|				+ ВЫБОР
		|					КОГДА ЕСТЬNULL(Контрагенты.Отчество, """") = """"
		|						ТОГДА """"
		|					ИНАЧЕ "" "" + ЕСТЬNULL(Контрагенты.Отчество, """")
		|				КОНЕЦ
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК ФИО,
		|	ВтДубли.КоличествоДублей КАК КоличествоДублей
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (
		|			ВЫБРАТЬ
		|				КонтрагентыВнутр.ИНН КАК ИНН,
		|				КОЛИЧЕСТВО(*) КАК КоличествоДублей
		|			ИЗ
		|				Справочник.Контрагенты КАК КонтрагентыВнутр
		|			ГДЕ
		|				НЕ КонтрагентыВнутр.ПометкаУдаления
		|				И КонтрагентыВнутр.ИНН <> """"
		|			СГРУППИРОВАТЬ ПО
		|				КонтрагентыВнутр.ИНН
		|			ИМЕЮЩИЕ
		|				КОЛИЧЕСТВО(*) > 1
		|		) КАК ВтДубли
		|			ПО Контрагенты.ИНН = ВтДубли.ИНН
		|ГДЕ
		|	НЕ Контрагенты.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО
		|	Контрагенты.ИНН,
		|	Контрагенты.Наименование";
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Если Результат.Колонки.Найти("ТипДубля") = Неопределено Тогда
		Результат.Колонки.Добавить("ТипДубля", Новый ОписаниеТипов("Строка", , , Новый КвалификаторыСтроки(30)));
	КонецЕсли;
	
	Для Каждого СтрокаТЗ Из Результат Цикл
		СтрокаТЗ.ТипДубля = "По ИНН";
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция СформироватьТаблицуДублейПоФИО(СсылкаНаОбработку = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Контрагенты.Ссылка КАК Контрагент,
		|	Контрагенты.Наименование КАК Наименование,
		|	Контрагенты.ИНН КАК ИНН,
		|	ЕСТЬNULL(Контрагенты.Фамилия, """") + "" "" + ЕСТЬNULL(Контрагенты.Имя, """")
		|		+ ВЫБОР
		|			КОГДА ЕСТЬNULL(Контрагенты.Отчество, """") = """"
		|				ТОГДА """"
		|			ИНАЧЕ "" "" + ЕСТЬNULL(Контрагенты.Отчество, """")
		|		КОНЕЦ КАК ФИО
		|ПОМЕСТИТЬ ВтКонтрагенты
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	НЕ Контрагенты.ПометкаУдаления
		|	И ЕСТЬNULL(Контрагенты.Фамилия, """") <> """" // Защита от организаций без ФИО
		|;
		|
		|ВЫБРАТЬ
		|	ВтКонтрагенты.ФИО КАК ФИО,
		|	КОЛИЧЕСТВО(*) КАК КоличествоДублей
		|ПОМЕСТИТЬ ВтДублиФИО
		|ИЗ
		|	ВтКонтрагенты КАК ВтКонтрагенты
		|СГРУППИРОВАТЬ ПО
		|	ВтКонтрагенты.ФИО
		|ИМЕЮЩИЕ
		|	КОЛИЧЕСТВО(*) > 1
		|;
		|
		|ВЫБРАТЬ
		|	ВтКонтрагенты.Контрагент КАК Контрагент,
		|	ВтКонтрагенты.Наименование КАК Наименование,
		|	ВтКонтрагенты.ИНН КАК ИНН,
		|	ВтКонтрагенты.ФИО КАК ФИО,
		|	ВтДублиФИО.КоличествоДублей КАК КоличествоДублей
		|ИЗ
		|	ВтКонтрагенты КАК ВтКонтрагенты
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВтДублиФИО КАК ВтДублиФИО
		|			ПО ВтКонтрагенты.ФИО = ВтДублиФИО.ФИО
		|УПОРЯДОЧИТЬ ПО
		|	ВтКонтрагенты.ФИО,
		|	ВтКонтрагенты.Наименование";
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Если Результат.Колонки.Найти("ТипДубля") = Неопределено Тогда
		Результат.Колонки.Добавить("ТипДубля", Новый ОписаниеТипов("Строка", , , Новый КвалификаторыСтроки(30)));
	КонецЕсли;
	
	Для Каждого СтрокаТЗ Из Результат Цикл
		СтрокаТЗ.ТипДубля = "По ФИО";
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПроверитьНаличиеРеквизита(ИмяРеквизита) Экспорт
	МетаданныеКонтрагента = Метаданные.Справочники.Контрагенты;
	Возврат НЕ (МетаданныеКонтрагента.Реквизиты.Найти(ИмяРеквизита) = Неопределено);
КонецФункции


Функция СведенияОВнешнейОбработке() Экспорт
	
	// Создаем структуру, которая будет хранить все данные о нашей обработке
	ПараметрыРегистрации = Новый Структура;
	
	// --- 1. ОСНОВНЫЕ ПАРАМЕТРЫ ---
	// Вид: "ПечатнаяФорма" (для отчетов из меню Печать), 
	//      "ДополнительнаяОбработка" (для сервисных действий в разделе Сервис),
	//      "ЗаполнениеОбъекта" (для заполнения ТЧ документа)
	ПараметрыРегистрации.Вставить("Вид", "ДополнительнаяОбработка"); 
	
	// Как будет называться пункт в меню печати или список дополнительных обработок
	ПараметрыРегистрации.Вставить("Наименование", "Поиск дублей контрагентов");
	
	// Версия вашего файла (удобно менять при доработках)
	ПараметрыРегистрации.Вставить("Версия", "1.0"); 
	
	// Описание, которое увидит администратор при добавлении файла
	ПараметрыРегистрации.Вставить("Информация", "Позволяет найти дубли контрагентов по ИНН и ФИО.");
	
	// Безопасный режим рекомендуется ставить Ложь, если обработка работает с файлами или пишет логи напрямую в диск
	ПараметрыРегистрации.Вставить("БезопасныйРежим", Ложь); 
	
	
	// --- 2. НАЗНАЧЕНИЕ (ГДЕ ПОКАЗЫВАТЬ ОБРАБОТКУ) ---
	// Если это печатная форма, перечисляем документы, где она должна появиться.
	МассивНазначений = Новый Массив;
	// Пример для документов Альфа-Авто. Замените на нужные вам типы:
	МассивНазначений.Добавить("Справочник.Контрагенты"); 
	// Для заказ-нарядов используется документ "ЗаказНаряд"
	// МассивНазначений.Добавить("Документ.ЗаказНаряд"); 
	ПараметрыРегистрации.Вставить("Назначение", МассивНазначений);
	
	
	// --- 3. КОМАНДЫ (КНОПКИ) ---
	// Здесь описываем кнопки, которые появятся у пользователя.
	Команды = Новый ТаблицаЗначений;
	Команды.Колонки.Добавить("Представление"); // Название кнопки
	Команды.Колонки.Добавить("Идентификатор"); // Уникальный код команды (латиницей)
	Команды.Колонки.Добавить("Использование"); // Как вызывается код
	Команды.Колонки.Добавить("ПоказыватьОповещение"); // Крутится ли колесико загрузки
	Команды.Колонки.Добавить("Модификатор"); // Обычно пусто, для ЭДО бывает "ПечатьMXL"
	
	НоваяКоманда = Команды.Добавить();
	НоваяКоманда.Представление = "Найти дубли"; // Текст на кнопке
	НоваяКоманда.Идентификатор = "НайтиДублиКонтрагентов"; // Любое уникальное имя латиницей
	
	// Варианты Использования:
	// - "ВызовСерверногоМетода": выполнится процедура Печать() в модуле объекта (для печатных форм).
	// - "ОткрытиеФормы": просто откроется экранная форма обработки (для сервисных инструментов).
	НоваяКоманда.Использование = "ОткрытиеФормы"; 
	
	НоваяКоманда.ПоказыватьОповещение = Истина; 
	НоваяКоманда.Модификатор = "";
	
	ПараметрыРегистрации.Вставить("Команды", Команды);
	
	Возврат ПараметрыРегистрации;
	
КонецФункции
