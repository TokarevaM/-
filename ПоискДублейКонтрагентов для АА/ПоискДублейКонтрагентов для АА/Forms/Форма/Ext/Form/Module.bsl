&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Элементы.ТаблицаРезультат.Отображение = ОтображениеТаблицы.Список;
	
	// Корректные имена элементов (без пробелов)
	НастроитьКолонку("ТаблицаРезультатКонтрагент", "Контрагент", 30);
	НастроитьКолонку("ТаблицаРезультатНаименование", "Наименование", 40);
	НастроитьКолонку("ТаблицаРезультатИНН", "ИНН", 15);
	НастроитьКолонку("ТаблицаРезультатФИО", "ФИО (для физ. лиц)", 30);
	НастроитьКолонку("ТаблицаРезультатКоличествоДублей", "Дублей", 8);
	НастроитьКолонку("ТаблицаРезультатТипДубля", "Тип дубля", 12);
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьКолонку(ИмяЭлемента, Заголовок, Ширина)
	Элемент = Элементы.Найти(ИмяЭлемента);
	Если Элемент <> Неопределено Тогда
		Элемент.Заголовок = Заголовок;
		Элемент.Ширина = Ширина;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура НайтиДублиПоИНН(Команда)
	
	ТаблицаРезультат.Очистить();
			
	НайтиДублиПоИНННаСервере();
	
	Если ТаблицаРезультат.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Дубли по ИНН не найдены.");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура НайтиДублиПоИНННаСервере()
	
	// Получаем реальный объект обработки для доступа к методам модуля объекта
	Обработка = РеквизитФормыВЗначение("Объект");
	ТаблицаДублей = Обработка.СформироватьТаблицуДублейПоИНН();
	
	// Оптимизация: вместо цикла Добавить/Присвоить используем прямую загрузку
	ТаблицаРезультат.Загрузить(ТаблицаДублей);
	
КонецПроцедуры

&НаКлиенте
Процедура НайтиДублиПоФИО(Команда)
	
	ТаблицаРезультат.Очистить();
	
	НайтиДублиПоФИОНаСервере();
	
	Если ТаблицаРезультат.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Дубли по ФИО не найдены.");         
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура НайтиДублиПоФИОНаСервере()
	
	Обработка = РеквизитФормыВЗначение("Объект");
	
	Если НЕ Обработка.ПроверитьНаличиеРеквизита("Фамилия") Тогда
		ВызватьИсключение "В справочнике Контрагенты не найден реквизит ""Фамилия"". Поиск по ФИО невозможен.";
	КонецЕсли;
	
	ТаблицаДублей = Обработка.СформироватьТаблицуДублейПоФИО();
	ТаблицаРезультат.Загрузить(ТаблицаДублей);

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьСписок(Команда)
	ТаблицаРезультат.Очистить();
КонецПроцедуры


//не использую
&НаКлиенте
Процедура ОткрытьКартуКонтрагента(Команда)
	
	Если ТаблицаРезультат.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТекущийКонтрагент = Элементы.ТаблицаРезультат.ТекущаяСтрока;
	
	Если ТекущийКонтрагент = Неопределено Тогда
		ПоказатьПредупреждение(, "Выберите строку с контрагентом.");
		Возврат;
	КонецЕсли;
	
	НайденнаяСтрока = ТаблицаРезультат.НайтиПоИдентификатору(ТекущийКонтрагент);
	Если НайденнаяСтрока <> Неопределено И ЗначениеЗаполнено(НайденнаяСтрока.Контрагент) Тогда
		ПоказатьЗначение(, НайденнаяСтрока.Контрагент);
	КонецЕсли;
	
КонецПроцедуры

