
&НаКлиенте
Процедура НайтиДубли(Команда)
	
	ТаблицаРезультатов.Очистить();
	
	НайтиДублиНаСервере();
	
	Если ТаблицаРезультатов.Количество() = 0 Тогда
		Сообщить("Дублирующаяся номенклатура не найдена.");
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из ТаблицаРезультатов Цикл
		Сообщить(
			"Дубликат: «" + СтрокаТаблицы.Наименование
			+ "» — найдено повторений: " + СтрокаТаблицы.Количество
		);
	КонецЦикла;
	
	Сообщить("Всего найдено дублирующихся наименований: " + ТаблицаРезультатов.Количество());
	
КонецПроцедуры

&НаСервере
Процедура НайтиДублиНаСервере()
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Номенклатура.Наименование КАК Наименование,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Номенклатура.Ссылка) КАК Количество
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	НЕ Номенклатура.ПометкаУдаления
		|
		|СГРУППИРОВАТЬ ПО
		|	Номенклатура.Наименование
		|
		|ИМЕЮЩИЕ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Номенклатура.Ссылка) > 1
		|
		|УПОРЯДОЧИТЬ ПО
		|	Количество УБЫВ"
	);
	
	Результат = Запрос.Выполнить();
	
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НовСтрока = ТаблицаРезультатов.Добавить();
		НовСтрока.Наименование = Выборка.Наименование;
		НовСтрока.Количество    = Выборка.Количество;
	КонецЦикла;
	
КонецПроцедуры
