  
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	// 1. Начинаем транзакцию — все действия будут атомарными: либо всё пройдёт, либо ничего
	НачатьТранзакцию();
	
	Попытка
		
		// 2. Формируем движения по регистру накопления «ОстаткиМатериалов»
		Движения.ОстаткиМатериалов.Записывать = Истина;
		
		
		// регистр ОстаткиМатериалов Приход
		Движение = Движения.ОстаткиМатериалов.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = Дата;
		Движение.Склад = Склад;
		Движение.Номенклатура = Продукция;
		Движение.Количество = КоличествоПродукции;
		
		
		// --- Списание ингредиентов (Расход) ---
		Для Каждого СтрокаИнгредиенты Из Ингредиенты Цикл
			
			Движение = Движения.ОстаткиМатериалов.Добавить();
			Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
			Движение.Период = Дата;
			Движение.Склад = Склад;
			Движение.Номенклатура = СтрокаИнгредиенты.Номенклатура;
			Движение.Количество = СтрокаИнгредиенты.Количество;
			
		КонецЦикла;
		
		
		// 3. Записываем движения (фактически данные ещё не зафиксированы в БД, но подготовлены)
		Движения.Записать();
		
		// 4. Проверяем остатки с учетом только что сформированных движений
		// Ключевой момент: используем опцию «ДЛЯ ИЗМЕНЕНИЯ», чтобы заблокировать строки регистра
		// и избежать проблем параллельного доступа (race condition)
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОстаткиМатериаловОстатки.Склад КАК Склад,
		|	ОстаткиМатериаловОстатки.Номенклатура КАК Номенклатура,
		|	ОстаткиМатериаловОстатки.КоличествоОстаток КАК КоличествоОстаток
		|ИЗ
		|	РегистрНакопления.ОстаткиМатериалов.Остатки(
		|		,
		|		Склад = &Склад
		|	) КАК ОстаткиМатериаловОстатки
		|ГДЕ
		|	ОстаткиМатериаловОстатки.КоличествоОстаток < 0
		|
		|ДЛЯ ИЗМЕНЕНИЯ
		|	РегистрНакопления.ОстаткиМатериалов.Остатки";
		
		Запрос.УстановитьПараметр("Склад", Склад);
		
		РезультатЗапроса = Запрос.Выполнить();
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		// Если найдены отрицательные остатки — отменяем всё
		Если ВыборкаДетальныеЗаписи.Количество() > 0 Тогда
			
			Отказ = Истина; // Отменяем проведение документа
			
			// Формируем понятное сообщение для пользователя
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Не удалось провести документ: обнаружены отрицательные остатки!";
			Сообщение.Поле = "Склад";
			//Сообщение.УстановитьДанные(Объект);
			Сообщение.Сообщить();
			
			// Выводим детали по каждой позиции с минусом
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				
				// Примечание: в реальном коде здесь нужно сопоставить с тем, сколько хотели списать,
				// но так как мы уже записали движения, отрицательный остаток и есть нехватка.
				ТекстОшибки = СтрШаблон(
				"Не хватает материала '%1' на складе '%2'.", 
				ВыборкаДетальныеЗаписи.Номенклатура, 
				ВыборкаДетальныеЗаписи.Склад
				);
				
				Сообщить(ТекстОшибки); // Или использовать более продвинутый механизм вывода ошибок
				
			КонецЦикла;
			
			// Отменяем транзакцию — все движения откатятся
			ОтменитьТранзакцию();
			
		Иначе
			// 5. Если всё хорошо — фиксируем транзакцию
			ЗафиксироватьТранзакцию();
			
		КонецЕсли;
		
	Исключение
		// В случае любой ошибки — откат
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;	
	
КонецПроцедуры

  
  
